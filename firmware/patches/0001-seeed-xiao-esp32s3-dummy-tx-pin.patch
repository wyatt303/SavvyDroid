+    if (settings.systemType == 4)
+    {
+        // Seeed XIAO ESP32-S3, wired the same way as this project's sibling
+        // repo DucatiMonster937CanBus (see its firmware/include/config.h):
+        // a passive CAN logger, deliberately never driving the real
+        // transceiver TXD pin from the TWAI peripheral. D0/GPIO1 is wired
+        // to the transceiver's TXD but is held statically HIGH (recessive)
+        // as a plain GPIO -- it is NOT connected to TWAI at all. TWAI's own
+        // TX is instead routed to D3/GPIO4, which is physically
+        // unconnected on this board (confirmed against
+        // DucatiMonster937CanBus's own comment for the same pin/board).
+        // This is a second, physical safety layer on top of whatever
+        // listen-only mode SavvyDroid's SETUP_CANBUS command configures at
+        // runtime -- see docs/PROTOCOL.md in the SavvyDroid repo for why
+        // that command's exact byte layout is the one part of this project
+        // not yet independently verified against source.
+        Logger::console("Running on Seeed XIAO ESP32-S3 (SavvyDroid wiring)");
+        canBuses[0] = &CAN0;
+        SysSettings.LED_CANTX = 255;
+        SysSettings.LED_CANRX = 255;
+        SysSettings.LED_LOGGING = 255;
+        SysSettings.LED_CONNECTION_STATUS = 255;
+        SysSettings.fancyLED = false;
+        SysSettings.logToggle = false;
+        SysSettings.txToggle = true;
+        SysSettings.rxToggle = true;
+        SysSettings.lawicelAutoPoll = false;
+        SysSettings.lawicelMode = false;
+        SysSettings.lawicellExtendedMode = false;
+        SysSettings.lawicelTimestamping = false;
+        SysSettings.numBuses = 1;
+        SysSettings.isWifiActive = false;
+        SysSettings.isWifiConnected = false;
+        strcpy(deviceName, EVTV_NAME);
+        strcpy(otaHost, "media3.evtv.me");
+        strcpy(otaFilename, "/esp32s3ret.bin");
+
+        pinMode(GPIO_NUM_1, OUTPUT);
+        digitalWrite(GPIO_NUM_1, HIGH); // D0: hold transceiver TXD recessive, NOT driven by TWAI
+        CAN0.setCANPins(GPIO_NUM_2, GPIO_NUM_4); // rx=D1/GPIO2 (real transceiver RXD), tx=D3/GPIO4 (dummy, unconnected)
+    }
